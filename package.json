{
  "name": "contextadapt",
  "version": "0.2.0",
  "description": "Help every Agent use the smallest context that can still act safely.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cooleryu/ContextAdapt.git"
  },
  "homepage": "https://github.com/cooleryu/ContextAdapt#readme",
  "bugs": "https://github.com/cooleryu/ContextAdapt/issues",
  "keywords": [
    "ai-agents",
    "agent-safety",
    "context-management",
    "codex",
    "oh-my-pi"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "contextadapt": "dist/packages/cli/src/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/packages/core/src/index.d.ts",
      "import": "./dist/packages/core/src/index.js"
    },
    "./codex": {
      "types": "./dist/packages/codex/src/index.d.ts",
      "import": "./dist/packages/codex/src/index.js"
    },
    "./omp": {
      "types": "./dist/packages/omp/src/index.d.ts",
      "import": "./dist/packages/omp/src/index.js"
    }
  },
  "omp": {
    "extensions": [
      "./dist/packages/omp/src/index.js"
    ]
  },
  "files": [
    "dist/",
    "schema/",
    "examples/context-recommendation.json",
    "examples/auto-context-trace.jsonl",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "contextadapt": "node dist/packages/cli/src/bin.js",
    "demo": "npm run contextadapt -- demo",
    "demo:recommend": "npm run contextadapt -- recommend examples/auto-context-trace.jsonl",
    "experiment:long-context": "node --import tsx experiments/long-context/src/run.ts",
    "experiment:long-context:dry": "node --import tsx experiments/long-context/src/run.ts --dry-run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "test:python-oracle": "cd research/python && python3 -m unittest discover -s tests",
    "check": "npm run format:check && npm run typecheck && npm test && npm run test:python-oracle && npm run build && npm pack --dry-run --cache .npm-cache"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.22.0",
    "typescript": "^6.0.0"
  }
}
