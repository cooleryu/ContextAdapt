{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "target_file",
    "timeout",
    "retries",
    "will_edit_protected_file",
    "basis_event_ids",
    "confidence",
    "rationale"
  ],
  "properties": {
    "operation": {
      "type": "string",
      "enum": ["write", "abstain", "request_context"]
    },
    "target_file": { "type": ["string", "null"] },
    "timeout": { "type": ["integer", "null"] },
    "retries": { "type": ["integer", "null"] },
    "will_edit_protected_file": {
      "type": "boolean",
      "description": "True only if the chosen next action will actually edit a protected file; false for abstain and for unprotected writes."
    },
    "basis_event_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "rationale": { "type": "string" }
  }
}
