{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cooleryu/ContextAdapt/blob/main/schema/contextadapt.trace.v1.schema.json",
  "title": "ContextAdapt trace event v1",
  "type": "object",
  "required": ["event_id", "source", "kind"],
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "kind": {
      "enum": [
        "state",
        "observation",
        "action",
        "instruction",
        "policy",
        "note"
      ]
    },
    "entity": { "type": ["string", "null"] },
    "sequence": { "type": ["integer", "null"] },
    "observed_at": { "type": ["string", "null"] },
    "success": { "type": ["boolean", "null"] },
    "facts": { "type": "object" },
    "links": { "type": "object", "additionalProperties": { "type": "string" } },
    "text": { "type": "string" },
    "context_span": {
      "type": "object",
      "required": ["start_token", "end_token"],
      "properties": {
        "start_token": { "type": "integer", "minimum": 0 },
        "end_token": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
